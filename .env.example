# Provider: auto | ipo_guru | upstox | nse | test_data
IPO_PROVIDER=auto
IPO_GURU_API_KEY=
UPSTOX_ACCESS_TOKEN=

# OpenRouter model is configurable without code changes.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=8000
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_REASONING_MAX_TOKENS=1024

# Gmail SMTP
EMAIL_FROM=yourgmail@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_TO=reader1@example.com,reader2@example.com
FAILURE_TO=owner@example.com

# Optional tuning
PROCESSED_RETENTION_DAYS=15
ARTIFACT_RETENTION_DAYS=15
NEWS_LOOKBACK_DAYS=730
NEWS_MAX_EVENTS=10
REQUEST_TIMEOUT_SECONDS=25
REQUEST_RETRIES=3
DRY_RUN=false
